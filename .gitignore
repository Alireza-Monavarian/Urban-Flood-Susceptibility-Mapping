data/processed/sensitivity/

# MaxEnt fit trees: keep only the summary tables the paper reports.
data/processed/maxent/*
!data/processed/maxent/jackknife_gains.csv
!data/processed/maxent/variable_importance_combined.csv
!data/processed/maxent/sensitivity/
data/processed/maxent/sensitivity/*
!data/processed/maxent/sensitivity/sensitivity_summary.csv
!data/processed/maxent/tuning/
data/processed/maxent/tuning/*
!data/processed/maxent/tuning/aicc_results.csv
!data/processed/maxent/response_curves/
data/processed/maxent/response_curves/*
!data/processed/maxent/response_curves/response_curves.csv

